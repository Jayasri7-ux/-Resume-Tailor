  "technology_explanations": {
    "docker": {
      "category": "DevOps & Containerization",
      "explanation": "Docker packages applications into standardized standalone containers containing code, runtime, and libraries, ensuring the application runs identically across development, staging, and production environments."
    },
    "kubernetes": {
      "category": "DevOps & Orchestration",
      "explanation": "Kubernetes (K8s) automates the deployment, horizontal scaling, load balancing, and self-healing management of containerized applications across server clusters."
    },
    "aws": {
      "category": "Cloud Infrastructure",
      "explanation": "Amazon Web Services (AWS) is a cloud computing platform providing on-demand compute (EC2), scalable storage (S3), relational database hosting (RDS), and serverless execution (Lambda)."
    },
    "azure": {
      "category": "Cloud Infrastructure",
      "explanation": "Microsoft Azure is an enterprise cloud computing suite supporting cloud-hosted virtual machines, app services, serverless functions, and relational/NoSQL databases."
    },
    "gcp": {
      "category": "Cloud Infrastructure",
      "explanation": "Google Cloud Platform provides high-performance cloud hosting, managed Kubernetes (GKE), BigQuery analytics, and AI/ML model deployment infrastructure."
    },
    "redis": {
      "category": "Databases & In-Memory Caching",
      "explanation": "Redis is an ultra-fast in-memory key-value data store commonly used for caching database queries, session management, message brokering, and rate-limiting."
    },
    "graphql": {
      "category": "API Architecture",
      "explanation": "GraphQL is an API query language that lets clients request precisely the data fields they need, preventing over-fetching and consolidating multi-endpoint REST calls into a single request."
    },
    "typescript": {
      "category": "Programming Languages",
      "explanation": "TypeScript is a statically typed superset of JavaScript developed by Microsoft that catches bugs during compilation and enables enterprise-scale refactoring and autocomplete."
    },
    "postgresql": {
      "category": "Relational Databases",
      "explanation": "PostgreSQL is an open-source, highly reliable object-relational database management system supporting ACID transactions, complex joins, and JSON/indexing capabilities."
    },
    "ci/cd": {
      "category": "DevOps & Automation",
      "explanation": "Continuous Integration & Continuous Deployment (CI/CD) automates running automated unit tests and deploying code changes to production servers upon git push."
    },
    "microservices": {
      "category": "System Architecture",
      "explanation": "An architectural pattern where a large application is structured as a collection of small, independently deployable services communicating over lightweight REST APIs or message queues."
    },
    "terraform": {
      "category": "DevOps & Infrastructure as Code",
      "explanation": "Terraform enables developers to provision and manage cloud infrastructure using declarative configuration files instead of manual console clicks."
    },
    "kafka": {
      "category": "Distributed Event Streaming",
      "explanation": "Apache Kafka is a distributed event store and stream-processing platform for high-throughput, fault-tolerant real-time data pipelines."
    },
    "celery": {
      "category": "Asynchronous Task Queues",
      "explanation": "Celery is an asynchronous distributed task queue for Python (often used with Django/Flask and Redis) to process background jobs like email dispatch and data scraping."
    },
    "tailwind css": {
      "category": "Frontend Styling Framework",
      "explanation": "A utility-first CSS framework providing composable utility classes to build bespoke, responsive user interfaces quickly without writing custom CSS selectors."
    }
  },
